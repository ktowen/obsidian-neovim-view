{
	"name": "obsidian-neovim-view",
	"version": "0.0.1",
	"description": "Neovim as an editor view inside Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"format": "prettier --write .",
		"check": "prettier --check . && eslint . && tsc -noEmit -skipLibCheck && vitest run"
	},
	"license": "MIT",
	"dependencies": {
		"@msgpack/msgpack": "^3.1.3"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@eslint/json": "^0.14.0",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "1.13.1",
		"prettier": "^3.9.9",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.71.0",
		"vitest": "^3.2.4"
	}
}
